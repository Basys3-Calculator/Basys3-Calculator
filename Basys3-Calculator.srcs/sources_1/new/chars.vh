// chars.vh - character codes shared by font_rom and the OLED renderer
// Codes 0-15 are used by the original calculator. Codes 16 and above are used
// by representation labels, hexadecimal digits A-F, and the mode-selection UI.
// Usage: `include "chars.vh"  (inside the module body)

localparam [5:0] CH_0     = 6'd0,
                 CH_1     = 6'd1,
                 CH_2     = 6'd2,
                 CH_3     = 6'd3,
                 CH_4     = 6'd4,
                 CH_5     = 6'd5,
                 CH_6     = 6'd6,
                 CH_7     = 6'd7,
                 CH_8     = 6'd8,
                 CH_9     = 6'd9,
                 CH_PLUS  = 6'd10,
                 CH_MINUS = 6'd11,
                 CH_MUL   = 6'd12,
                 CH_DIV   = 6'd13,
                 CH_EQ    = 6'd14,
                 CH_SPACE = 6'd15,
                 CH_A     = 6'd16,
                 CH_B     = 6'd17,
                 CH_C     = 6'd18,
                 CH_D     = 6'd19,
                 CH_E     = 6'd20,
                 CH_F     = 6'd21,
                 CH_I     = 6'd22,
                 CH_N     = 6'd23,
                 CH_O     = 6'd24,
                 CH_T     = 6'd25,
                 CH_H     = 6'd26,
                 CH_X     = 6'd27,
                 CH_COLON = 6'd28,
                 CH_L     = 6'd29,
                 CH_M     = 6'd30,
                 CH_P     = 6'd31,
                 CH_R     = 6'd32,
                 CH_S     = 6'd33,
                 CH_U     = 6'd34,
                 CH_W     = 6'd35;
